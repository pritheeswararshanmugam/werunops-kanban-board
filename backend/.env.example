# Backend storage driver: firebase, supabase, or file
WERUNOPS_STATE_DRIVER=firebase

# CORS
CORS_ALLOW_ORIGINS=https://pritheeswararshanmugam.github.io

# Firebase Realtime Database settings (required when WERUNOPS_STATE_DRIVER=firebase)
FIREBASE_DATABASE_URL=https://werun-ops-backoffice-default-rtdb.firebaseio.com
FIREBASE_AUTH_SECRET=your-firebase-database-secret-from-console
FIREBASE_STATE_PATH=werunops_state

# Supabase REST settings (required when WERUNOPS_STATE_DRIVER=supabase)
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STATE_TABLE=werunops_state
SUPABASE_STATE_ROW_ID=1
